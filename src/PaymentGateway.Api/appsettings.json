{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BankApi": {
    "BaseUrl": "https://localhost:8080",
    "PaymentEndpoint": "/payments",
    "TimeoutSeconds": 30,
    "RetryPolicy": {
      "MaxRetries": 3,
      "BaseDelayMilliseconds": 200
    }
  }
}
